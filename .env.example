# ClearAuth environment. Copy to .env and fill what you have.
# EVERYTHING is optional — with no keys set, every integration falls back to a
# deterministic mock and the full pipeline still runs end-to-end.

# --- LLM (optional; no key → rule-based fallback in every chain) ---
ANTHROPIC_API_KEY=
GEMINI_API_KEY=

# --- API location (the dashboard talks to this) ---
NEXT_PUBLIC_API_URL=http://localhost:3001

# --- Supabase (optional; no config → in-memory store only) ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# --- Apify: scrape payer coverage criteria (Sahiel) ---
APIFY_API_TOKEN=
# Optional: override the scraping actor (default apify/google-search-scraper)
APIFY_COVERAGE_ACTOR=

# --- Tigris: object storage for notes + generated packets (Shanay) ---
TIGRIS_STORAGE_ACCESS_KEY_ID=
TIGRIS_STORAGE_SECRET_ACCESS_KEY=
TIGRIS_STORAGE_BUCKET=clearauth
TIGRIS_ENDPOINT=https://t3.storage.dev

# --- Rtrvr.ai: submit the PA form to the payer portal (Sahiel) ---
RTRVR_API_KEY=
RTRVR_PORTAL_URL=http://localhost:3009/submit
# Optional stage control: api | trick | fallback | auto (default auto = A→B→C)
RTRVR_STRATEGY=
# Optional: pre-recorded Trick id (enables strategy B) + base URL overrides
RTRVR_TRICK_ID=
RTRVR_API_BASE=https://api.rtrvr.ai
RTRVR_A2W_BASE=https://agent.rtrvr.ai/v1/a2w/runs

# --- Opsera: compliance audit via MCP (Pranav) ---
OPSERA_MCP_URL=https://mcp.opsera.io/mcp
OPSERA_API_TOKEN=

# --- Optional CORS overrides for deployed apps (extend the localhost allowlist) ---
DASHBOARD_APP_URL=
PAYER_PORTAL_URL=
